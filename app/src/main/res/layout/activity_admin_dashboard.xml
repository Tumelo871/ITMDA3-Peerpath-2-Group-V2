<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/adminRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F5F8FF">
    <!--  Dashboard header  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="18dp" android:background="#082B6F">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PeerPath Admin" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Manage tutor applications, users, reviews and learning materials." android:textColor="#EAF3FF" android:textSize="14sp"/>
    </LinearLayout>
    <!--  Existing admin sections  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="4dp">
        <Button android:id="@+id/btnAdminApplications" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:layout_marginEnd="4dp" android:text="Tutor applications" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#0D5BE1"/>
        <Button android:id="@+id/btnAdminUsers" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="Manage users" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#0D5BE1"/>
    </LinearLayout>
    <!--  New admin investigation and repository tools  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="2dp" android:paddingEnd="12dp" android:paddingBottom="4dp">
        <Button android:id="@+id/btnAdminReviewFollowups" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:layout_marginEnd="4dp" android:text="Review follow-ups" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#0D5BE1"/>
        <Button android:id="@+id/btnAdminTutorMaterials" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="4dp" android:text="Tutor materials" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#0D5BE1"/>
    </LinearLayout>
    <Button android:id="@+id/btnAdminSponsorApprovals" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:layout_marginEnd="12dp" android:minHeight="48dp" android:text="Sponsor approvals" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#0D5BE1"/>
    <Button android:id="@+id/btnAdminLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="2dp" android:layout_marginEnd="12dp" android:minHeight="48dp" android:text="Log out" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#082B6F"/>
    <TextView android:id="@+id/txtAdminSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingTop="12dp" android:paddingEnd="18dp" android:paddingBottom="4dp" android:text="Pending tutor applications" android:textColor="#17243A" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/txtAdminStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingTop="4dp" android:paddingEnd="18dp" android:paddingBottom="8dp" android:text="Ready" android:textColor="#52627A" android:textSize="14sp" android:accessibilityLiveRegion="polite"/>
    <ProgressBar android:id="@+id/adminProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone"/>
    <ScrollView android:id="@+id/adminScrollView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/adminContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="4dp" android:paddingEnd="16dp" android:paddingBottom="24dp"/>
    </ScrollView>
</LinearLayout>