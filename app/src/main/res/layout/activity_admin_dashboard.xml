<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/adminRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F5F8FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="16dp" android:background="#082B6F">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_title" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/admin_subtitle" android:textColor="#EAF3FF" android:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="4dp">
        <Button android:id="@+id/btnAdminApplications" style="?android:attr/buttonStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/admin_tutor_applications" android:textAllCaps="false"/>
        <Button android:id="@+id/btnAdminUsers" style="?android:attr/buttonStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/admin_manage_users" android:textAllCaps="false"/>
    </LinearLayout>
    <Button android:id="@+id/btnAdminLogout" style="?android:attr/buttonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="@string/admin_logout" android:textAllCaps="false"/>
    <TextView android:id="@+id/txtAdminSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingTop="6dp" android:paddingEnd="18dp" android:paddingBottom="2dp" android:text="@string/admin_pending_title" android:textColor="#17243A" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/txtAdminStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingTop="4dp" android:paddingEnd="18dp" android:paddingBottom="6dp" android:text="@string/admin_ready" android:textColor="#52627A" android:textSize="14sp"/>
    <ProgressBar android:id="@+id/adminProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/adminContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp"/>
    </ScrollView>
</LinearLayout>