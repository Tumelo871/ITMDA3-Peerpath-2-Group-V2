<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/peer_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <!--   HEADER   -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_marginEnd="12dp" android:contentDescription="PeerPath" android:scaleType="centerInside" android:src="@drawable/peerpath_logo"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hello 👋" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvRole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Learner" android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="55dp" android:layout_height="55dp">
                <Button android:id="@+id/btnNotifications" android:layout_width="55dp" android:layout_height="55dp" android:background="@drawable/bg_circle_blue" android:text="🔔" android:textSize="20sp"/>
                <TextView android:id="@+id/tvNotificationCount" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|end" android:background="@drawable/bg_circle" android:gravity="center" android:text="0" android:textColor="@color/peer_navy" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
        <!--   LEVEL / XP CARD   -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_level_card" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvLevel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Level 1 · Newcomer" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvXp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip" android:paddingStart="14dp" android:paddingTop="5dp" android:paddingEnd="14dp" android:paddingBottom="5dp" android:text="0 XP" android:textColor="@color/peer_gold" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/progressXp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="14dp" android:max="100" android:progress="0" android:progressTint="@color/peer_gold" android:progressBackgroundTint="#40FFFFFF"/>
            <TextView android:id="@+id/tvXpHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="100 XP to Level 2" android:textColor="#CCE0FF" android:textSize="13sp"/>
            <TextView android:id="@+id/tvRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/white" android:textSize="14sp" android:visibility="gone"/>
        </LinearLayout>
        <!--   STATS   -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvSessions" android:layout_width="0dp" android:layout_height="80dp" android:layout_marginStart="0dp" android:layout_weight="1" android:background="@drawable/bg_subject_card" android:gravity="center" android:text="0 Sessions" android:textColor="@color/peer_blue" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvStreak" android:layout_width="0dp" android:layout_height="80dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_subject_card" android:gravity="center" android:text="0 Day streak" android:textColor="@color/peer_blue" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvBadges" android:layout_width="0dp" android:layout_height="80dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_subject_card" android:gravity="center" android:text="0/7 Badges" android:textColor="@color/peer_blue" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <!--   COMPLETION   -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_quote" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tvProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Learning progress: 0%" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
            <ProgressBar android:id="@+id/progressLearning" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:max="100" android:progress="0" android:progressTint="@color/peer_blue"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="What would you like to do?" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/cardFindTutor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="🔍" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find a Tutor" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search by name or module" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardMySessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="📅" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Learning Sessions" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bookings, chat and ratings" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <!--   LEARNER REVIEWS   -->
        <LinearLayout android:id="@+id/cardMyReviews" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="⭐" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Reviews" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate completed tutoring sessions and share feedback" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardTutorRequests" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="📨" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student Requests" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accept or decline new requests" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardTutorSessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="🎓" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Teaching Sessions" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chat and mark sessions complete" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardEditProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="✏️" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit Tutor Profile" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subject, bio and experience" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <!--  PRIVATE REVIEW FOLLOW-UPS  -->
        <LinearLayout android:id="@+id/cardReviewFollowups" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="✉️" android:textSize="25sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Admin follow-ups" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Read and reply to messages about your tutor review." android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="💬" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Messages" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chat with your tutors and students" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <!--   VERIFIED TUTOR APPLICATION   -->
        <LinearLayout android:id="@+id/cardBecomeTutor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="🎓" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvBecomeTutorTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Become a Verified Tutor" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvBecomeTutorSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apply with module evidence and teach peers" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <!--   REAL FILE RESOURCE REPOSITORY   -->
        <LinearLayout android:id="@+id/cardResources" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="📂" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resource Repository" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upload and open real PDF, image and text resources" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <!--   ADMIN REVIEW   -->
        <LinearLayout android:id="@+id/cardAdminReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="🛡️" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Admin Tutor Verification" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Review evidence and approve tutor applications" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardMaterials" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="📘" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Learning Materials" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Browse notes, links and videos" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardMyMaterials" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="📤" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Materials" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add and manage what you share" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardAnnounce" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="📢" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Announce to Students" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send one message to all your students" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardLeaderboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="🏆" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Leaderboard" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See who is earning the most XP" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cardBadges" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_subject_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="🏅" android:textSize="26sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Badges" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your achievements" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="›" android:textColor="@color/peer_blue" android:textSize="24sp"/>
        </LinearLayout>
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_button_navy" android:text="Log Out" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>