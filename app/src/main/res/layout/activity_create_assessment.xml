<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assessment Centre"
            android:textColor="#142B4A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Create tests, quizzes and assignments for your learners."
            android:textColor="#667085"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select learner / tutoring session"
            android:textColor="#142B4A"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSession"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Assessment title"
            android:textColor="#142B4A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAssessmentTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:hint="e.g. Mathematics Test 1"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Subject"
            android:textColor="#142B4A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAssessmentSubject"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:hint="e.g. Mathematics"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Assessment format"
            android:textColor="#142B4A"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerAssessmentType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Instructions for the learner"
            android:textColor="#142B4A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAssessmentInstructions"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Explain what the learner must do..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Submission deadline"
            android:textColor="#142B4A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAssessmentDueDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select deadline"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="#E8F0FC"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submission methods"
                android:textColor="#142B4A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbOnlineAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Allow learners to answer in the app"
                android:textColor="#142B4A" />

            <CheckBox
                android:id="@+id/cbFileSubmission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Allow PDF / DOCX uploads"
                android:textColor="#142B4A" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/questionBuilderSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question builder"
                android:textColor="#142B4A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuestionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 questions | Total: 0 marks"
                android:textColor="#475467"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/questionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnAddQuestion"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#DCE9FA"
                android:text="+ Add question"
                android:textAllCaps="false"
                android:textColor="#1456A0"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnPublishAssessment"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#1456A0"
            android:text="Publish assessment"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
